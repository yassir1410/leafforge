import { create } from 'zustand';
import { invokeCommand } from '../lib/tauri';

export const useProjectStore = create((set, get) => ({
  project: null,
  fileTree: null,
  recentProjects: [],
  isLoading: false,
  error: null,

  setProject: (project) => set({ project, error: null }),
  setError: (error) => set({ error }),
  clearError: () => set({ error: null }),

  loadRecentProjects: async () => {
    try {
      const recent = await invokeCommand('list_recent_projects');
      set({ recentProjects: recent || [] });
    } catch (err) {
      console.error('Failed to load recent projects:', err);
    }
  },

  createProject: async (projectPath, projectName) => {
    set({ isLoading: true, error: null });
    try {
      const project = await invokeCommand('create_project', {
        project_path: projectPath,
        project_name: projectName || null,
      });
      set({ project, isLoading: false });
      localStorage.setItem('leafforge_last_project', projectPath);
      await get().refreshFileTree();
      await get().loadRecentProjects();
      return project;
    } catch (err) {
      set({ error: err.message, isLoading: false });
      throw err;
    }
  },

  openProject: async (projectPath) => {
    set({ isLoading: true, error: null });
    try {
      const project = await invokeCommand('open_project', {
        project_path: projectPath,
      });
      set({ project, isLoading: false });
      localStorage.setItem('leafforge_last_project', projectPath);
      await get().refreshFileTree();
      await get().loadRecentProjects();
      return project;
    } catch (err) {
      set({ error: err.message, isLoading: false });
      throw err;
    }
  },

  refreshFileTree: async () => {
    const { project } = get();
    if (!project) return;
    try {
      const tree = await invokeCommand('list_project_files', {
        project_root: project.path,
      });
      set({ fileTree: tree });
    } catch (err) {
      console.error('Failed to refresh file tree:', err);
      set({ error: err.message });
    }
  },

  createFile: async (targetPath, initialContent = '') => {
    const { project } = get();
    if (!project) return;
    try {
      await invokeCommand('create_file', {
        project_root: project.path,
        file_path: targetPath,
        initial_content: initialContent || null,
      });
      await get().refreshFileTree();
    } catch (err) {
      set({ error: err.message });
      throw err;
    }
  },

  createDirectory: async (targetPath) => {
    const { project } = get();
    if (!project) return;
    try {
      await invokeCommand('create_directory', {
        project_root: project.path,
        dir_path: targetPath,
      });
      await get().refreshFileTree();
    } catch (err) {
      set({ error: err.message });
      throw err;
    }
  },

  renameNode: async (oldPath, newName) => {
    const { project } = get();
    if (!project) return;
    try {
      const newPath = await invokeCommand('rename_node', {
        project_root: project.path,
        old_path: oldPath,
        new_name: newName,
      });
      await get().refreshFileTree();
      return newPath;
    } catch (err) {
      set({ error: err.message });
      throw err;
    }
  },

  deleteNode: async (targetPath) => {
    const { project } = get();
    if (!project) return;
    try {
      await invokeCommand('delete_node', {
        project_root: project.path,
        target_path: targetPath,
      });
      await get().refreshFileTree();
    } catch (err) {
      set({ error: err.message });
      throw err;
    }
  },
}));
</file>

<file path="src/stores/useSettingsStore.js">
import { create } from 'zustand';

const defaultSettings = {
  fontSize: 14,
  tabSize: 2,
  wordWrap: 'on',
  lineNumbers: 'on',
  minimap: false,
  defaultCompiler: 'latexmk',
  autoSave: true,
  autoSaveDelay: 1500,
};

const loadSettings = () => {
  if (typeof window === 'undefined') return defaultSettings;
  try {
    const raw = localStorage.getItem('leafforge_settings');
    return raw ? { ...defaultSettings, ...JSON.parse(raw) } : defaultSettings;
  } catch (e) {
    return defaultSettings;
  }
};

export const useSettingsStore = create((set, get) => ({
  ...loadSettings(),

  updateSetting: (key, value) => {
    set((state) => {
      const next = { ...state, [key]: value };
      if (typeof window !== 'undefined') {
        const { updateSetting, resetSettings, ...savedFields } = next;
        localStorage.setItem('leafforge_settings', JSON.stringify(savedFields));
      }
      return next;
    });
  },

  resetSettings: () => {
    if (typeof window !== 'undefined') {
      localStorage.setItem('leafforge_settings', JSON.stringify(defaultSettings));
    }
    set(defaultSettings);
  },
}));
</file>

<file path="src/stores/useUIStore.js">
import { create } from 'zustand';

const savedTheme = typeof window !== 'undefined' ? localStorage.getItem('leafforge_theme') || 'dark' : 'dark';

export const useUIStore = create((set, get) => ({
  // Theme
  theme: savedTheme,
  toggleTheme: () => {
    const nextTheme = get().theme === 'dark' ? 'light' : 'dark';
    if (typeof window !== 'undefined') {
      localStorage.setItem('leafforge_theme', nextTheme);
      if (nextTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
    set({ theme: nextTheme });
  },
  setTheme: (theme) => {
    if (typeof window !== 'undefined') {
      localStorage.setItem('leafforge_theme', theme);
      if (theme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    }
    set({ theme });
  },

  // Panel sizing
  explorerWidth: 260,
  previewWidth: 420,
  bottomPanelHeight: 180,
  setExplorerWidth: (width) => set({ explorerWidth: Math.max(160, Math.min(width, 500)) }),
  setPreviewWidth: (width) => set({ previewWidth: Math.max(240, Math.min(width, 800)) }),
  setBottomPanelHeight: (height) => set({ bottomPanelHeight: Math.max(90, Math.min(height, 500)) }),

  // Panel visibility
  isExplorerOpen: true,
  isPreviewOpen: true,
  isBottomPanelOpen: true,
  bottomPanelTab: 'environment', // 'output' | 'problems' | 'environment'
  toggleExplorer: () => set((state) => ({ isExplorerOpen: !state.isExplorerOpen })),
  togglePreview: () => set((state) => ({ isPreviewOpen: !state.isPreviewOpen })),
  toggleBottomPanel: () => set((state) => ({ isBottomPanelOpen: !state.isBottomPanelOpen })),
  setBottomPanelTab: (tab) => set({ bottomPanelTab: tab, isBottomPanelOpen: true }),

  // Modals & Dialogs
  isSettingsOpen: false,
  isNewProjectOpen: false,
  isOpenProjectOpen: false,
  newFileDialog: null, // null | { parentPath, isDir }
  deleteConfirmDialog: null, // null | { path, name, isDir }
  renameDialog: null, // null | { path, name, isDir }

  openSettings: () => set({ isSettingsOpen: true }),
  closeSettings: () => set({ isSettingsOpen: false }),

  openNewProjectModal: () => set({ isNewProjectOpen: true }),
  closeNewProjectModal: () => set({ isNewProjectOpen: false }),

  openOpenProjectModal: () => set({ isOpenProjectOpen: true }),
  closeOpenProjectModal: () => set({ isOpenProjectOpen: false }),

  openNewFileDialog: (parentPath = '', isDir = false) =>
    set({ newFileDialog: { parentPath, isDir } }),
  closeNewFileDialog: () => set({ newFileDialog: null }),

  openDeleteConfirm: (path, name, isDir) =>
    set({ deleteConfirmDialog: { path, name, isDir } }),
  closeDeleteConfirm: () => set({ deleteConfirmDialog: null }),

  openRenameDialog: (path, name, isDir) =>
    set({ renameDialog: { path, name, isDir } }),
  closeRenameDialog: () => set({ renameDialog: null }),
}));
</file>

