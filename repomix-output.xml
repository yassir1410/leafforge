import React from 'react';
import {
  FolderPlus,
  FolderOpen,
  Save,
  Undo2,
  Redo2,
  Play,
  Sun,
  Moon,
  Settings,
  PanelLeft,
  PanelRight,
  PanelBottom,
  Sparkles,
} from 'lucide-react';
import { useProjectStore } from '../../stores/useProjectStore';
import { useEditorStore } from '../../stores/useEditorStore';
import { useUIStore } from '../../stores/useUIStore';
import { useSettingsStore } from '../../stores/useSettingsStore';
import { Button } from '../common/Button';

export function Toolbar({ onUndo, onRedo }) {
  const { project } = useProjectStore();
  const { getActiveTab, saveActiveTab } = useEditorStore();
  const {
    theme,
    toggleTheme,
    openSettings,
    openNewProjectModal,
    openOpenProjectModal,
    isExplorerOpen,
    toggleExplorer,
    isPreviewOpen,
    togglePreview,
    isBottomPanelOpen,
    toggleBottomPanel,
  } = useUIStore();
  const { defaultCompiler, updateSetting } = useSettingsStore();

  const activeTab = getActiveTab();
  const isDirty = activeTab?.isDirty || false;

  return (
    <header className="h-12 border-b border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900 px-3 flex items-center justify-between select-none z-20 shrink-0">
      {/* Left: Branding & Project info */}
      <div className="flex items-center gap-3">
