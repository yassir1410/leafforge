export function Button({
  children,
  variant = 'secondary',
  size = 'md',
  className = '',
  disabled = false,
  onClick,
  type = 'button',
  title,
  ...props
}) {
  const baseStyles = 'inline-flex items-center justify-center font-medium rounded-sm transition-colors focus:outline-hidden focus:ring-2 focus:ring-emerald-500/50 disabled:opacity-50 disabled:cursor-not-allowed select-none';

  const variants = {
    primary: 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs active:bg-emerald-800',
    secondary: 'bg-slate-200 hover:bg-slate-300 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 active:bg-slate-300 dark:active:bg-slate-650',
    outline: 'border border-slate-300 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300',
    ghost: 'hover:bg-slate-100 dark:hover:bg-slate-800 text-slate-700 dark:text-slate-300',
    danger: 'bg-rose-600 hover:bg-rose-700 text-white shadow-xs active:bg-rose-800',
  };

  const sizes = {
    xs: 'text-xs px-2 py-1 gap-1',
    sm: 'text-xs px-2.5 py-1.5 gap-1.5',
    md: 'text-sm px-3 py-1.5 gap-2',
    lg: 'text-base px-4 py-2 gap-2.5',
  };

  return (
    <button
      type={type}
      disabled={disabled}
      onClick={onClick}
      title={title}
      className={cn(baseStyles, variants[variant], sizes[size], className)}
      {...props}
    >
      {children}
    </button>
  );
}
</file>

<file path="src/components/common/FileIcon.jsx">
import React from 'react';
import {
  Folder,
  FolderOpen,
  FileText,
  FileCode,
  BookOpen,
  Image,
  File,
  FileCheck,
} from 'lucide-react';

export function FileIcon({ isDir, isOpen, extension, className = 'w-4 h-4' }) {
  if (isDir) {
    return isOpen ? (
      <FolderOpen className={`${className} text-amber-500 shrink-0`} />
    ) : (
      <Folder className={`${className} text-amber-500 shrink-0`} />
    );
  }

  const ext = (extension || '').toLowerCase();

  switch (ext) {
    case 'tex':
    case 'cls':
    case 'sty':
      return <FileCode className={`${className} text-emerald-500 shrink-0`} />;
    case 'bib':
      return <BookOpen className={`${className} text-amber-600 shrink-0`} />;
    case 'pdf':
      return <FileText className={`${className} text-rose-500 shrink-0`} />;
    case 'png':
    case 'jpg':
    case 'jpeg':
    case 'svg':
    case 'gif':
    case 'webp':
      return <Image className={`${className} text-sky-500 shrink-0`} />;
    case 'log':
    case 'aux':
    case 'toc':
    case 'out':
      return <FileCheck className={`${className} text-slate-400 shrink-0`} />;
    default:
      return <File className={`${className} text-slate-400 shrink-0`} />;
  }
}
</file>

<file path="src/components/common/Modal.jsx">
import React, { useEffect, useRef } from 'react';
import { X } from 'lucide-react';
import { cn } from '../../lib/utils';

export function Modal({
  isOpen,
  onClose,
  title,
  description,
  children,
  maxWidth = 'max-w-md',
  footer,
}) {
  const modalRef = useRef(null);

  useEffect(() => {
    const handleKeyDown = (e) => {
      if (e.key === 'Escape' && isOpen) {
        onClose();
      }
    };

    if (isOpen) {
      window.addEventListener('keydown', handleKeyDown);
      document.body.style.overflow = 'hidden';
    }

    return () => {
      window.removeEventListener('keydown', handleKeyDown);
      document.body.style.overflow = 'unset';
    };
  }, [isOpen, onClose]);

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-in fade-in duration-150">
      <div
        ref={modalRef}
        role="dialog"
        aria-modal="true"
        aria-labelledby="modal-title"
        className={cn(
          'w-full bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-lg shadow-2xl flex flex-col overflow-hidden animate-in zoom-in-95 duration-150',
          maxWidth
        )}
      >
        {/* Header */}
        <div className="flex items-center justify-between px-5 py-3.5 border-b border-slate-200 dark:border-slate-800">
          <div>
            <h3 id="modal-title" className="text-base font-semibold text-slate-900 dark:text-slate-100">
              {title}
            </h3>
            {description && (
              <p className="text-xs text-slate-500 dark:text-slate-400 mt-0.5">{description}</p>
            )}
          </div>
          <button
            onClick={onClose}
            className="p-1 rounded-sm text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors"
          >
            <X className="w-4 h-4" />
          </button>
        </div>

        {/* Body */}
        <div className="p-5 overflow-y-auto max-h-[calc(100vh-14rem)]">{children}</div>

        {/* Footer */}
        {footer && (
          <div className="flex items-center justify-end gap-2.5 px-5 py-3 border-t border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-900/60">
            {footer}
          </div>
        )}
      </div>
    </div>
  );
}
</file>

<file path="src/components/editor/EditorTabs.jsx">
import React from 'react';
import { X } from 'lucide-react';
import { useEditorStore } from '../../stores/useEditorStore';
import { FileIcon } from '../common/FileIcon';
import { Modal } from '../common/Modal';
import { Button } from '../common/Button';

export function EditorTabs() {
  const {
    tabs,
    activeTabId,
    setActiveTab,
    requestCloseTab,
    closeTab,
    pendingCloseTab,
    dismissCloseDialog,
    saveTab,
  } = useEditorStore();

  if (tabs.length === 0) return null;

  const handleSaveAndClose = async () => {
    if (!pendingCloseTab) return;
    try {
      await saveTab(pendingCloseTab.id);
      closeTab(pendingCloseTab.id, true);
    } catch (err) {
      console.error('Failed to save before closing:', err);
    }
  };

  const handleDiscardAndClose = () => {
    if (!pendingCloseTab) return;
    closeTab(pendingCloseTab.id, true);
  };

  return (
    <>
      <div className="h-9 bg-slate-100 dark:bg-slate-925 border-b border-slate-200 dark:border-slate-800 flex items-stretch overflow-x-auto select-none scrollbar-none shrink-0">
        {tabs.map((tab) => {
          const isActive = tab.id === activeTabId;
          const ext = tab.name.split('.').pop();

          return (
            <div
              key={tab.id}
              onClick={() => setActiveTab(tab.id)}
              className={`group flex items-center gap-2 px-3 border-r border-slate-200 dark:border-slate-800 text-xs cursor-pointer transition-colors relative min-w-[120px] max-w-[220px] ${
                isActive
                  ? 'bg-white dark:bg-slate-900 text-slate-900 dark:text-slate-100 font-medium'
                  : 'text-slate-600 dark:text-slate-400 hover:bg-slate-200/50 dark:hover:bg-slate-800/50'
              }`}
            >
              {/* Active top line indicator */}
              {isActive && (
                <div className="absolute top-0 left-0 right-0 h-[2px] bg-emerald-500" />
              )}

              <FileIcon isDir={false} extension={ext} className="w-3.5 h-3.5" />

              <span className="truncate flex-1" title={tab.path}>
                {tab.name}
              </span>

              {/* Dirty indicator / Close button */}
              <div className="flex items-center justify-center w-4 h-4 shrink-0">
                {tab.isDirty ? (
                  <button
                    onClick={(e) => {
                      e.stopPropagation();
                      requestCloseTab(tab.id);
                    }}
                    className="w-2.5 h-2.5 rounded-full bg-emerald-500 group-hover:hidden"
                    title="Unsaved changes"
                  />
                ) : null}

                <button
                  onClick={(e) => {
                    e.stopPropagation();
                    requestCloseTab(tab.id);
                  }}
                  className={`p-0.5 rounded text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 hover:bg-slate-200 dark:hover:bg-slate-700 ${
                    tab.isDirty ? 'hidden group-hover:block' : 'opacity-0 group-hover:opacity-100'
                  }`}
                  title="Close tab (Ctrl+W)"
                >
                  <X className="w-3 h-3" />
                </button>
              </div>
            </div>
          );
        })}
      </div>

      {/* Unsaved changes confirmation dialog */}
      <Modal
        isOpen={Boolean(pendingCloseTab)}
        onClose={dismissCloseDialog}
        title="Unsaved Changes"
        description={`Do you want to save the changes made to '${pendingCloseTab?.name}' before closing?`}
        footer={
          <>
            <Button variant="ghost" size="sm" onClick={dismissCloseDialog}>
              Cancel
            </Button>
            <Button variant="outline" size="sm" onClick={handleDiscardAndClose}>
              Discard Changes
            </Button>
            <Button variant="primary" size="sm" onClick={handleSaveAndClose}>
              Save & Close
            </Button>
          </>
        }
      >
        <p className="text-xs text-slate-600 dark:text-slate-400">
          Your changes will be permanently lost if you close this file without saving.
        </p>
      </Modal>
    </>
  );
}
</file>

